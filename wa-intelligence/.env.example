# wa-intelligence/.env — ARGOS S292 / C10T1 TEMPLATE (NO SECRETS)
# Copy to .env on the target host, fill values locally, then: chmod 600 .env
# NEVER commit the populated .env and never paste real tokens into chat/logs.

# ─────────────────────────────────────────────────────────────────
# CANONICAL RUNTIME / SAFETY
# ─────────────────────────────────────────────────────────────────

ARGOS_API_KEY=
ARGOS_AUTOMATION_ENABLED=0
ARGOS_WA_TRANSPORT=wwebjs

# Production release trees point to the existing external SQLite state. Never
# create a fresh empty DB merely because the code checkout moved.
ARGOS_DB_PATH=
BRIDGE_DB_PATH=
ARGOS_WA_PORT=9191
ARGOS_BIND_HOST=127.0.0.1
ARGOS_BRIDGE_POLL_MS=15000
ARGOS_GLOBAL_DAILY_LIMIT=40
ARGOS_DEALER_DAILY_LIMIT=3
ARGOS_BUSINESS_START_HOUR=9
ARGOS_BUSINESS_END_HOUR=18
ARGOS_BUSINESS_DAYS=1,2,3,4,5

# C11 live pilot: local non-secret identifier of the single controlled test DB
# row. The phone number stays only in SQLite and is never placed in Actions input
# or logs. Leave blank until the controlled test record is intentionally prepared.
ARGOS_C11_TEST_DEALER_ID=

# ─────────────────────────────────────────────────────────────────
# LEGACY WWWEBJS TRANSPORT — ROLLBACK/DIAGNOSTIC ONLY
# ─────────────────────────────────────────────────────────────────

ARGOS_WA_CLIENT_ID=argos-business
ARGOS_WA_SESSION_DIR=
CHROME_EXECUTABLE_PATH=

# ─────────────────────────────────────────────────────────────────
# OFFICIAL WHATSAPP BUSINESS PLATFORM / CLOUD API
# Required together when ARGOS_WA_TRANSPORT=cloud.
# ─────────────────────────────────────────────────────────────────

META_GRAPH_API_VERSION=v25.0
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_WABA_ID=
META_WA_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
ARGOS_WA_WEBHOOK_PUBLIC_URL=

# Business-initiated messages outside the 24h customer-service window MUST use
# approved Meta message templates. Create/approve templates whose BODY text
# matches wa-intelligence/meta_templates.json exactly, then place their names
# here. Names/language are non-secret; approval is revalidated read-only on boot.
META_WA_TEMPLATE_LANGUAGE=it
META_WA_TEMPLATE_DAY1_NAME=
META_WA_TEMPLATE_DAY7_NAME=
META_WA_TEMPLATE_DAY12_NAME=

# NOTE: A public/business phone number is NOT opt-in evidence. Before the queue
# can initiate WhatsApp contact, record a traceable grant with:
#   python whatsapp_consent.py grant --db-path ... --dealer-id ... \
#     --source <consent-source> --evidence-id <traceable-id>
# Revocation is fail-closed with `whatsapp_consent.py revoke`.

# ─────────────────────────────────────────────────────────────────
# OPTIONAL ANALYSIS / OBSERVABILITY
# ─────────────────────────────────────────────────────────────────

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4-5

# Historical Telegram credential was exposed during C10 inspection. Production
# must use a ROTATED local token and local chat identity; never reuse or commit
# either historical value.
ARGOS_TELEGRAM_TOKEN=
ARGOS_TELEGRAM_CHAT_ID=

GMAIL_FERRETTI_EMAIL=
GMAIL_FERRETTI_APP_PASSWORD=
ARGOS_PROXY_URL=
ARGOS_ADMIN_SECRET=
