# wa-intelligence/.env — TEMPLATE (no secrets)
# Copia a .env e compila valori. chmod 600 .env. NEVER commit.
#
# S169 audit: classificazione mandatory hard-fail vs degradabili graceful
# basata su grep process.env.* in wa-daemon.js + telegram-handler.py + cf_alert_monitor.py

# ─────────────────────────────────────────────────────────────────
# MANDATORY HARD (wa-daemon non parte / si rompe a runtime)
# ─────────────────────────────────────────────────────────────────

# nessuna — wa-daemon ha default per SESSION_ID, DB_PATH (post-S169 fix).
# Bridge S168 attiva solo se BRIDGE_DB_PATH set (graceful no-op altrimenti).

# ─────────────────────────────────────────────────────────────────
# DEGRADABILI (subprocess fallisce ma daemon continua, log warn)
# ─────────────────────────────────────────────────────────────────

# OpenRouter LLM cascade (response-analyzer.py subprocess)
# Senza → response classifier subprocess fallisce, ma daemon riceve msg comunque
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4-5

# Telegram bot HITL (telegram-handler.py subprocess fire-and-forget)
# Senza → alert telegram silenziosi (no crash daemon)
ARGOS_TELEGRAM_TOKEN=
ARGOS_TELEGRAM_CHAT_ID=931063621

# HTTP API auth (porta 9191 /send /qr)
# Senza → API endpoint senza auth (rischio se daemon esposto rete). Imposta!
# Genera: openssl rand -hex 32
ARGOS_API_KEY=

# Gmail FERRETTI (cf_alert_monitor.py — SOLO se CF monitor in uso)
# Senza → cf-monitor process fallisce ma wa-daemon non impattato
GMAIL_FERRETTI_EMAIL=
GMAIL_FERRETTI_APP_PASSWORD=

# WA session ID (default 'argos-business' funziona — cambia solo se serve)
WA_CLIENT_ID=argos-business

# ─────────────────────────────────────────────────────────────────
# S168 BRIDGE WIRE-UP — feature flag (zero impact se vuoto)
# ─────────────────────────────────────────────────────────────────

# Path SQLite condiviso wa-daemon ↔ comm-broker
# Se vuoto → hook bridge no-op completo, daemon pre-S168 behavior
BRIDGE_DB_PATH=/Users/macbook/Documents/combaretrovamiauto-enterprise/comm-broker/bridge.sqlite

# Poll interval bridge_outbound (ms). Default 30000 (30s)
BRIDGE_POLL_INTERVAL_MS=30000
