# wa-intelligence/.env — ARGOS S292 / C10T1 TEMPLATE (NO SECRETS)
# Copy to .env on the target host, fill values locally, then: chmod 600 .env
# NEVER commit the populated .env and never paste real tokens into chat/logs.

# ─────────────────────────────────────────────────────────────────
# CANONICAL RUNTIME / SAFETY
# ─────────────────────────────────────────────────────────────────

# Required by runtime_entrypoint.py in production.
ARGOS_API_KEY=

# C10/C10T1 must remain 0. Setting this to 1 is a later explicit rollout gate.
ARGOS_AUTOMATION_ENABLED=0

# Explicit transport selection. Keep wwebjs for rollback; use cloud only after
# official Meta onboarding + HTTPS webhook route are verified.
ARGOS_WA_TRANSPORT=wwebjs

# Canonical DB/bridge paths are machine-local. Do not commit host-specific paths.
BRIDGE_DB_PATH=
ARGOS_WA_PORT=9191
ARGOS_BIND_HOST=127.0.0.1
ARGOS_BRIDGE_POLL_MS=15000
ARGOS_GLOBAL_DAILY_LIMIT=40
ARGOS_DEALER_DAILY_LIMIT=3
ARGOS_BUSINESS_START_HOUR=9
ARGOS_BUSINESS_END_HOUR=18
ARGOS_BUSINESS_DAYS=1,2,3,4,5

# ─────────────────────────────────────────────────────────────────
# LEGACY WWWEBJS TRANSPORT — ROLLBACK ONLY
# ─────────────────────────────────────────────────────────────────

ARGOS_WA_CLIENT_ID=argos-business
ARGOS_WA_SESSION_DIR=
CHROME_EXECUTABLE_PATH=

# ─────────────────────────────────────────────────────────────────
# OFFICIAL WHATSAPP BUSINESS PLATFORM / CLOUD API
# Required together when ARGOS_WA_TRANSPORT=cloud.
# ─────────────────────────────────────────────────────────────────

META_GRAPH_API_VERSION=v25.0
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_WABA_ID=
META_WA_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# Public HTTPS callback that must route only the webhook path to the local
# canonical daemon. This is a deployment/smoke value, not consumed by the daemon.
ARGOS_WA_WEBHOOK_PUBLIC_URL=

# ─────────────────────────────────────────────────────────────────
# OPTIONAL ANALYSIS / OBSERVABILITY
# ─────────────────────────────────────────────────────────────────

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4-5

# Historical Telegram credential was exposed during C10 inspection. Production
# must use a ROTATED local token; never reuse an exposed value.
ARGOS_TELEGRAM_TOKEN=
ARGOS_TELEGRAM_CHAT_ID=931063621

GMAIL_FERRETTI_EMAIL=
GMAIL_FERRETTI_APP_PASSWORD=
ARGOS_PROXY_URL=
ARGOS_ADMIN_SECRET=
