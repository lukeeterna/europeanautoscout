{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(python3 * --dry-run)",
      "Bash(python3 tests/*)",
      "Bash(ssh * curl *status*)",
      "Bash(cat /tmp/argos*)",
      "Bash(sqlite3 * PRAGMA*)",
      "Bash(sqlite3 * SELECT*)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(bash .claude/scripts/*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git checkout -- *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/session_start.sh 2>/dev/null || echo 'Session start script not found'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Prima di chiudere: hai aggiornato memory/MEMORY.md se questa sessione ha prodotto cambiamenti significativi? Se si', procedi. Se no, aggiorna ora."
          }
        ]
      }
    ]
  }
}
