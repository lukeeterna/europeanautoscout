{
  "name": "argos-proxy",
  "version": "1.0.0",
  "private": true,
  "description": "ARGOS contract signing + bonifico bancario manuale (no Stripe v2)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "d1:local": "wrangler d1 execute argos-contracts --file=migrations/0001_init.sql --local",
    "d1:remote": "wrangler d1 execute argos-contracts --file=migrations/0001_init.sql --remote"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "pdf-lib": "^1.17.1",
    "@pdf-lib/fontkit": "^1.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250313.0",
    "typescript": "^5.7.0",
    "wrangler": "^3.22.0"
  }
}
